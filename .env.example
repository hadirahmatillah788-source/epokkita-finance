# Server Port
PORT=3030

# Opsi 1: Menggunakan Single Connection String (Direkomendasikan untuk Cloud: Render, Railway, Supabase, Neon)
DATABASE_URL=postgres://user:password@host:port/epokkita_db

# Opsi 2: Menggunakan Parameter Database Terpisah (Untuk VPS / Localhost)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=epokkita_db

# Set 'false' hanya jika database lokal tanpa SSL
DB_SSL=true
